# Copy this file to .env and fill in real values. Never commit .env.

# Discord bot token from the Discord Developer Portal (Bot tab).
DISCORD_TOKEN=

# Guild (server) ID for NCI's Discord, used to sync slash commands instantly
# during development instead of waiting for the global ~1hr propagation.
DISCORD_GUILD_ID=

# Dash / DaySmart Recreation API access.
# DASH_COMPANY is the company code in Dash URLs, e.g. the "cid"/"company"
# query param (NCI's is "dryice").
DASH_COMPANY=dryice
DASH_API_BASE_URL=https://api.daysmartrecreation.com
DASH_API_KEY=

# Where bot state (games, survey responses, payment reminder tracking) is
# stored. Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///dashbot.db

# How often (minutes) to poll Dash for schedule/roster/payment/stat changes.
DASH_SYNC_INTERVAL_MINUTES=15

# Set to "true" to use the in-memory mock Dash client instead of calling the
# real API. Useful for local development before a Dash API key exists.
DASH_USE_MOCK_CLIENT=false
